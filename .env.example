
# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Kafka
KAFKA_EXTERNAL_PORT=9092

# Service host ports
PRODUCT_CATALOG_PORT=3001
ORDER_SERVICE_PORT=3000
INVENTORY_SERVICE_PORT=3002
PAYMENT_GATEWAY_PORT=3005
PAYMENT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3003
API_GATEWAY_PORT=8080

# Toxiproxy — API for injecting toxics, and the proxied payment-gateway listener
TOXIPROXY_API_PORT=8474
TOXIPROXY_PAYMENT_PORT=3105

# Observability stack
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
TEMPO_PORT=3200
LOKI_PORT=3100
PROMETHEUS_PORT=9090
# Grafana's container port is 3000, which order-service already owns on the
# host, so it is published on 3300 instead.
GRAFANA_PORT=3300
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── Instrumentation ───
# Services export OpenTelemetry (traces + logs + metrics) over OTLP/gRPC to the
# otel-collector at http://otel-collector:4317. That endpoint and each service's
# OTEL_SERVICE_NAME are set inline in docker-compose.yml (fixed internal values),
# so there are no host-tunable knobs here. postgres_exporter is scraped by
# Prometheus on :9187 and is reachable on the host at the same port for debugging.
